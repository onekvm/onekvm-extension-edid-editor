{
  "manifest_version": 1,
  "id": "edid",
  "i18n": {
    "default": {
      "name": "EDID Editor",
      "description": "Edit HDMI EDID files. Core applies a saved file to the capture chip."
    },
    "zh": {
      "name": "EDID 编辑器",
      "description": "编辑 HDMI EDID 文件。Core 负责把保存的文件应用到采集芯片。"
    },
    "zh-TW": {
      "name": "EDID 編輯器",
      "description": "編輯 HDMI EDID 檔案。Core 負責把儲存的檔案套用到擷取晶片。"
    }
  },
  "version": "@VERSION@",
  "api_version": 2,
  "architecture": "@ARCH@",
  "kind": "service",
  "author": "OneKVM",
  "homepage": "https://github.com/onekvm/onekvm-extension-edid",
  "entrypoint": "bin/onekvm-extension-edid",
  "permissions": [],
  "capabilities": [],
  "device_compatibility": [
    {"machine": "nanokvm", "variants": ["cube", "pcie", "lite"]}
  ],
  "default_enabled": true,
  "icon": {"source": "lucide", "name": "monitor"},
  "page": {
    "title": "EDID Editor",
    "renderer": "vue",
    "entrypoint": "web/page.js",
    "icon": {"source": "lucide", "name": "monitor"}
  },
  "controller": {
    "runtime": "executable",
    "entrypoint": "bin/onekvm-extension-edid",
    "arguments": ["--controller"],
    "timeout_seconds": 5
  },
  "methods": {
    "list": {},
    "read": {},
    "save": {},
    "delete": {}
  },
  "directories": [
    {
      "id": "presets",
      "kind": "edid",
      "role": "preset",
      "path": "share/edid",
      "location": "package"
    },
    {
      "id": "custom",
      "kind": "edid",
      "role": "custom",
      "path": "edid",
      "location": "data",
      "writable": true
    }
  ],
  "settings_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["service_enabled"],
    "properties": {
      "service_enabled": {
        "type": "boolean",
        "title": "EDID file editor",
        "default": false,
        "readOnly": true,
        "i18n": {"default": "EDID file editor", "zh": "EDID 文件编辑器", "zh-TW": "EDID 檔案編輯器"}
      }
    }
  },
  "secret_fields": [],
  "memory_budget": "1M",
  "resource_limits": {
    "memory_max": "8M",
    "cpu_quota": "10%",
    "tasks_max": 8,
    "limit_nofile": 16
  },
  "healthcheck": {
    "type": "exec",
    "command": ["bin/onekvm-extension-edid", "--health"],
    "timeout_seconds": 5
  }
}
