{
  "manifest_version": 1,
  "id": "edid",
  "i18n": {
    "default": {
      "name": "EDID Editor",
      "description": "Provides HDMI EDID presets and a custom library. Other extensions may also publish kind edid."
    },
    "zh": {
      "name": "EDID 编辑器",
      "description": "提供 HDMI EDID 预设和自定义库。其他插件也可以发布 kind 为 edid 的目录。"
    },
    "zh-TW": {
      "name": "EDID 編輯器",
      "description": "提供 HDMI EDID 預設與自訂庫。其他擴充也可以發布 kind 為 edid 的目錄。"
    }
  },
  "version": "@VERSION@",
  "api_version": 2,
  "architecture": "@ARCH@",
  "kind": "service",
  "author": "OneKVM",
  "homepage": "https://github.com/onekvm/onekvm-extension-edid",
  "entrypoint": "bin/onekvm-extension-edid",
  "permissions": [],
  "capabilities": [],
  "device_compatibility": [
    {"machine": "nanokvm", "variants": ["cube", "pcie", "lite"]}
  ],
  "default_enabled": true,
  "icon": {"source": "lucide", "name": "monitor"},
  "page": {
    "title": "EDID",
    "renderer": "vue",
    "entrypoint": "web/page.js",
    "icon": {"source": "lucide", "name": "monitor"}
  },
  "directories": [
    {
      "id": "presets",
      "kind": "edid",
      "role": "preset",
      "path": "share/edid",
      "location": "package"
    },
    {
      "id": "custom",
      "kind": "edid",
      "role": "custom",
      "path": "edid",
      "location": "data",
      "writable": true
    }
  ],
  "settings_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["service_enabled"],
    "properties": {
      "service_enabled": {
        "type": "boolean",
        "title": "EDID libraries",
        "default": false,
        "readOnly": true,
        "i18n": {"default": "EDID libraries", "zh": "EDID 内容库", "zh-TW": "EDID 內容庫"}
      }
    }
  },
  "secret_fields": [],
  "memory_budget": "1M",
  "resource_limits": {
    "memory_max": "4M",
    "cpu_quota": "1%",
    "tasks_max": 1,
    "limit_nofile": 16
  },
  "healthcheck": {
    "type": "exec",
    "command": ["bin/onekvm-extension-edid", "--health"],
    "timeout_seconds": 5
  }
}
