{
  "manifest_version": 1,
  "id": "edid-editor",
  "i18n": {
    "default": {
      "name": "EDID Editor",
      "description": "Edit display information. A saved file is applied to the capture chip."
    },
    "zh": {
      "name": "EDID 编辑器",
      "description": "编辑显示器信息，保存后应用到采集芯片。"
    },
    "zh-TW": {
      "name": "EDID 編輯器",
      "description": "編輯顯示器資訊，儲存後套用到擷取晶片。"
    }
  },
  "version": "@VERSION@",
  "api_version": 2,
  "architecture": "@ARCH@",
  "kind": "service",
  "author": "OneKVM",
  "homepage": "https://github.com/onekvm/onekvm-extension-edid-editor",
  "permissions": [],
  "capabilities": [],
  "device_compatibility": [
    {"machine": "nanokvm", "variants": ["cube", "pcie", "lite"]},
    {"machine": "nanokvm-pro"}
  ],
  "default_enabled": true,
  "icon": {"source": "lucide", "name": "monitor"},
  "page": {
    "title": "EDID Editor",
    "renderer": "vue",
    "entrypoint": "web/page.js",
    "icon": {"source": "lucide", "name": "monitor"}
  },
  "methods": [
    {
      "name": "list",
      "command": ["bin/onekvm-extension-edid-editor", "list"],
      "args": []
    },
    {
      "name": "read",
      "command": ["bin/onekvm-extension-edid-editor", "read"],
      "args": [
        {"name": "source", "type": "string", "required": true},
        {"name": "id", "type": "string", "required": true}
      ]
    },
    {
      "name": "save",
      "command": ["bin/onekvm-extension-edid-editor", "save"],
      "args": [
        {"name": "id", "type": "string", "required": true},
        {"name": "data_hex", "type": "string", "required": true}
      ]
    },
    {
      "name": "delete",
      "command": ["bin/onekvm-extension-edid-editor", "delete"],
      "args": [
        {"name": "id", "type": "string", "required": true}
      ]
    }
  ],
  "directories": [
    {
      "id": "custom",
      "kind": "edid",
      "role": "custom",
      "path": "edid",
      "location": "data",
      "writable": true
    }
  ],
  "settings_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["service_enabled"],
    "properties": {
      "service_enabled": {
        "type": "boolean",
        "title": "EDID file editor",
        "default": false,
        "readOnly": true,
        "i18n": {"default": "EDID file editor", "zh": "EDID 文件编辑器", "zh-TW": "EDID 檔案編輯器"}
      }
    }
  },
  "secret_fields": [],
  "resource_limits": {
    "memory_max": "8M",
    "cpu_quota": "10%",
    "tasks_max": 8,
    "limit_nofile": 16
  }
}
